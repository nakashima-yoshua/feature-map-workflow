# The CLI pin must match the existing CodexProposer reviewed launch contract.
FROM node:22-bookworm-slim
ARG CODEX_PACKAGE_VERSION=0.159.0-alpha.3
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-lxml ca-certificates && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex@${CODEX_PACKAGE_VERSION}
WORKDIR /opt/fmw
COPY scripts/task_runner.py scripts/workflow_*.py ./scripts/
COPY skills/feature-map-workflow/assets/task-modules.json ./skills/feature-map-workflow/assets/
COPY runtime/Dockerfile* runtime/compose*.yaml ./runtime/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "-B"]
